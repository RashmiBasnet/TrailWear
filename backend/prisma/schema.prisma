generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique

  // Null for accounts that only ever signed in with Google — they have no
  // password to hash. Anything reading this must handle absence rather than
  // assume a hash is there.
  password String?

  // Google's `sub` claim: stable for the life of the account and never reused,
  // unlike the email, which a user can change. Unique, so one Google account
  // cannot be attached to two users.
  googleId String? @unique

  // Whether ownership of `email` has actually been proven — by clicking a
  // verification link, or by Google asserting email_verified. Registration alone
  // proves nothing: anyone can type someone else's address.
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  emailVerificationTokens EmailVerificationToken[]

  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bumped on logout/password change so previously issued JWTs stop validating.
  tokenVersion Int @default(0)

  // Brute-force lockout state.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Password lifecycle. Set on registration and every change, so expiry can be
  // measured and reuse of recent passwords blocked.
  passwordChangedAt DateTime          @default(now())
  passwordHistory   PasswordHistory[]

  // Multi-factor authentication (TOTP, RFC 6238).
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String? // AES-256-GCM encrypted; never stored in plaintext
  mfaBackupCodes String[] @default([]) // argon2 hashes, single use
  mfaLastUsedStep Int? // last accepted time step, blocks code replay

  cart      Cart?
  wishlist  WishlistItem[]
  orders    Order[]
  addresses Address[]
  auditLogs AuditLog[]
}

/**
 * Argon2 hashes of a user's previous passwords, so a new password can be
 * checked against them. Only hashes are kept — never the passwords themselves.
 */
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/**
 * Pending email-verification links.
 *
 * Only a SHA-256 hash of the token is stored, never the token itself: the
 * emailed link is a credential, and a leaked database should not hand out
 * working links. Plain SHA-256 rather than argon2 is deliberate — the token is
 * 32 random bytes, so there is nothing to brute-force and a slow hash would only
 * cost latency on every verification.
 */
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  // Set on first use. Kept rather than deleted so a replayed link can be told
  // apart from one that never existed.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  // Nullable: security events can happen without a known account, e.g. a failed
  // login for an email that does not exist. Those still need recording.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId String?
  ip       String?

  // Extra context (attempted email, failure reason). Never secrets.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  gender      Gender   @default(UNISEX)
  sizes       String[] @default([])
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      String[]
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  size      String  @default("")

  @@unique([cartId, productId, size])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  esewaRefId    String?
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  address       Address?      @relation(fields: [addressId], references: [id])
  addressId     String?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ESEWA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // snapshot price at time of order
  size      String  @default("")
}

model Address {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1   String
  line2   String?
  city    String
  country String
  zip     String
  orders  Order[]
}
